#!/bin/sh

message=$(cat "$1")

if [ ${#message} -lt 10 ]; then
    echo "ERROR: Commit message must be at least 10 characters."
    exit 1
fi

case "$message" in
    feat:*|fix:*|docs:*|refactor:*|chore:*)
        echo "Commit message check passed."
        ;;
    *)
        echo "ERROR: Invalid commit message prefix."
        exit 1
        ;;
esac
