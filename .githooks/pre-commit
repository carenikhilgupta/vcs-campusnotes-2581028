#!/bin/sh

files=$(git diff --cached --name-only --diff-filter=ACMR)

for file in $files
do
    case "$file" in
        .githooks/*) continue ;;
    esac

    if git show ":$file" 2>/dev/null | grep -nE 'TODO|FIXME'; then
        echo "ERROR: TODO or FIXME found in staged file: $file"
        exit 1
    fi
done

echo "Pre-commit check passed."
exit 0
